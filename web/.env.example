# Environment variables read by the Next.js app. Copy to web/.env.local and fill in; never commit values.
# Optional settings below are commented out so copying this file keeps the code defaults; uncomment one only to override it.
# The full list (pipeline, R2, tests) is in the repository-root .env.example.

# REQUIRED. Neon Postgres URL (isolated branch for local work). Required unless CFB_UI_TEST_MODE=1.
DATABASE_URL=
# REQUIRED to enable POST /api/revalidate. Secret for signed on-demand revalidation.
REVALIDATION_SECRET=
# Season the app publishes. Optional; defaults to the repo-owned season.
# CFB_PUBLICATION_SEASON=
# Set to predictions to publish model output; anything else publishes market only. Optional.
# CFB_PUBLICATION_MODE=
# Set to 0 to disable the Matchup pages (emergency switch). Optional; enabled by default.
# CFB_MATCHUP_ENABLED=
# Set to 0 to disable the release-keyed data cache (kill switch). Optional; enabled by default.
# CFB_DATA_CACHE=
# Set to 0 to hide the display-only notice. Optional; shown by default.
# CFB_DISPLAY_ONLY_NOTICE=
# Set to 1 to log every database query with a per-request count. Optional; debugging only.
# CFB_QUERY_LOG=
# Set to 1 to serve fixtures without a database (dev and Playwright).
# CFB_UI_TEST_MODE=
# Set to 1 to produce optional Stats visual review artifacts in Playwright.
# CFB_CHART_VISUALS=
# Playwright dev server port. Optional; default 3100.
# PLAYWRIGHT_PORT=
