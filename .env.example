# Environment variables read by the code. Copy to .env and fill in; never commit values.
# Active lines are REQUIRED credential and URL placeholders only. Every other entry is
# commented out, so copying this file to .env keeps the code's built-in defaults.
# Uncomment a line only when you need to override its default. An uncommented empty
# value is NOT the same as unset for most settings: it overrides the default with "".
# web/.env.example lists the subset the Next.js app reads.

# ============================================================================
# Required placeholders: CFBD, Neon Postgres (Production and Preview)
# ============================================================================
# REQUIRED for any CFBD fetch and for web logos:build.
CFBD_API_KEY=
# REQUIRED for catalog writes and publication: Neon Postgres URL for Production (pipeline role) and the web app.
DATABASE_URL=
# REQUIRED for Preview publication: Neon Postgres URL for the isolated Preview branch. Must differ from DATABASE_URL.
PREVIEW_DATABASE_URL=

# ============================================================================
# Required placeholders: Cloudflare R2 (used when CFB_STORAGE_BACKEND=r2)
# ============================================================================
# REQUIRED for production R2 runs.
CFB_R2_BUCKET=
CFB_R2_ACCOUNT_ID=
CFB_R2_ACCESS_KEY=
CFB_R2_SECRET_KEY=
# REQUIRED for production R2 runs. Form: https://ACCOUNT_ID.r2.cloudflarestorage.com
CFB_R2_ENDPOINT=
# REQUIRED when CFB_ARTIFACT_ENV=preview: isolated Preview bucket credentials.
CFB_R2_PREVIEW_BUCKET=
CFB_R2_PREVIEW_ACCOUNT_ID=
CFB_R2_PREVIEW_ACCESS_KEY=
CFB_R2_PREVIEW_SECRET_KEY=
CFB_R2_PREVIEW_ENDPOINT=
# REQUIRED when CFB_STORAGE_BACKEND=local (the default). Local data root path; not a credential.
CFB_MODEL_DATA_ROOT=

# ============================================================================
# Pipeline: runtime target and storage selection (optional; defaults in code)
# ============================================================================
# Storage backend: local, r2 or s3. Default: local.
# CFB_STORAGE_BACKEND=local
# Artifact environment: preview or production. Default: production.
# CFB_ARTIFACT_ENV=production
# Ephemeral working directory for build artifacts. Default: a temp root.
# CFB_WORK_ROOT=
# Internal marker set by the ops CLI after it resolves the target. Do not set manually.
# CFB_RUNTIME_TARGET_RESOLVED=
# Internal pipeline lease identity set by the ops CLI. Do not set manually.
# CFB_PIPELINE_RUN_ID=
# CFB_PIPELINE_LEASE_EPOCH=

# ============================================================================
# Pipeline: data sources, ingestion and retries (optional; defaults in code)
# ============================================================================
# Paid The Odds API key. Required only with CFB_ODDS_API_ENABLED=1 or approved historical backfills.
# THE_ODDS_API_KEY=
# Set to 1 to enable the weekly live The Odds API capture. Default: 0 (off).
# CFB_ODDS_API_ENABLED=0
# Maximum concurrent CFBD requests. Default: 2.
# CFB_CFBD_MAX_CONCURRENCY=2
# Per-request CFBD timeout in seconds. Default: 60.
# CFB_CFBD_REQUEST_TIMEOUT_SECONDS=60
# Source fetch retry attempts. Default: 4.
# CFB_SOURCE_MAX_ATTEMPTS=4
# Base retry delay in seconds. Default: 0.5.
# CFB_SOURCE_RETRY_BASE_SECONDS=0.5
# Maximum retry delay in seconds. Default: 8.
# CFB_SOURCE_RETRY_MAX_SECONDS=8
# Timeout in seconds for a fetch-source subprocess. Default: 600.
# CFB_SOURCE_SUBPROCESS_TIMEOUT_SECONDS=600
# Set to 1 to fail ingestion when a capture cannot be registered in Neon. Default: 0.
# CFB_REQUIRE_CATALOG=0
# Bronze catalog dual-write. Set to 1 or 0 to force it on or off. Default: 1 when
# CFB_STORAGE_BACKEND=r2, 0 otherwise. Do not uncomment with an empty value: an empty
# value disables dual-write even on R2.
# CFB_LAKE_DUAL_WRITE=1
# Ingestion run identifier passed to child processes by the ops CLI. Default: generated.
# CFB_INGESTION_RUN_ID=
# Optional generic JSON webhook for failed publish-week, freeze-week and close-week steps. Default: disabled.
# CFB_OPS_ALERT_WEBHOOK_URL=
# Webhook delivery timeout in seconds. Default: 5.
# CFB_OPS_ALERT_TIMEOUT_SECONDS=5

# ============================================================================
# Cloudflare R2 optional groups (commented: only for these workflows)
# ============================================================================
# Read-only historical source bucket. Required for source inventory and history import.
# CFB_R2_SOURCE_BUCKET=
# CFB_R2_SOURCE_ACCOUNT_ID=
# CFB_R2_SOURCE_ACCESS_KEY=
# CFB_R2_SOURCE_SECRET_KEY=
# CFB_R2_SOURCE_ENDPOINT=
# Ratings-lab research bucket (no Preview/production fallback). Required only for scripts/research R2 runs.
# CFB_R2_LAB_BUCKET=
# CFB_R2_LAB_ACCOUNT_ID=
# CFB_R2_LAB_ACCESS_KEY=
# CFB_R2_LAB_SECRET_KEY=
# CFB_R2_LAB_ENDPOINT=
# Ratings-lab read-only source bucket. Required together with the lab bucket.
# CFB_R2_LAB_SOURCE_BUCKET=
# CFB_R2_LAB_SOURCE_ACCOUNT_ID=
# CFB_R2_LAB_SOURCE_ACCESS_KEY=
# CFB_R2_LAB_SOURCE_SECRET_KEY=
# CFB_R2_LAB_SOURCE_ENDPOINT=
# Local ratings-lab storage root, used instead of lab R2. Optional research alternative.
# CFB_LAB_LOCAL_ROOT=

# ============================================================================
# AWS S3 (commented: alternative backend, used when CFB_STORAGE_BACKEND=s3)
# ============================================================================
# S3 bucket name. Required for the s3 backend.
# CFB_S3_BUCKET=
# S3 region. Default: us-east-1.
# CFB_S3_REGION=us-east-1
# AWS credentials. Required for the s3 backend unless the default AWS credential chain applies.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ============================================================================
# Web app (optional; also listed in web/.env.example)
# ============================================================================
# Secret for signed on-demand revalidation (POST /api/revalidate). Required only to enable that route.
# REVALIDATION_SECRET=
# Season the web app publishes. Default: the repo-owned season.
# CFB_PUBLICATION_SEASON=
# Set to predictions to publish model output; anything else publishes market only. Default: market only.
# CFB_PUBLICATION_MODE=
# Set to 0 to disable the Matchup pages (emergency switch). Default: enabled.
# CFB_MATCHUP_ENABLED=
# Set to 0 to disable the release-keyed data cache (kill switch). Default: enabled.
# CFB_DATA_CACHE=
# Set to 0 to hide the display-only notice. Default: shown.
# CFB_DISPLAY_ONLY_NOTICE=
# Set to 1 to log every database query with a per-request count. Default: off. Debugging only.
# CFB_QUERY_LOG=

# ============================================================================
# Tests and local UI tooling (optional)
# ============================================================================
# Postgres URL for DB integration tests. Disposable local cluster ONLY; never Preview or Production.
# TEST_DATABASE_URL=
# Second disposable local database used as the promotion target in tests/test_promotion.py. Same restriction.
# TEST_DATABASE_URL_TARGET=
# Set to 1 to run the web app on fixtures without a database (web dev and Playwright). Default: off.
# CFB_UI_TEST_MODE=
# Set to 1 to produce optional Stats visual review artifacts in the Playwright suite. Default: off.
# CFB_CHART_VISUALS=
# Playwright dev server port. Default: 3100.
# PLAYWRIGHT_PORT=3100
# Path to a served serving-projections.json for the optional parity test in tests/test_projection_resume.py.
# CKS_PARITY_SERVING_JSON=
