# CFB Model Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# CRITICAL: Data Storage Configuration
# ============================================================================
# Local data root (required only when CFB_STORAGE_BACKEND='local')
CFB_MODEL_DATA_ROOT='/Volumes/CK SSD/Coding Projects/cfb_model/'

# Storage backend: 'local' or 'r2' (or 's3' for AWS S3)
CFB_STORAGE_BACKEND='r2'

# Neon Postgres serving database for the Vercel web app
DATABASE_URL=''
# Isolated Neon branch used by local preview/replay operations (must differ)
PREVIEW_DATABASE_URL=''

# ============================================================================
# Cloudflare R2 Configuration (if using R2)
# ============================================================================
# R2 bucket name (e.g., 'cfb-model-data')
CFB_R2_BUCKET=''

# R2 Account ID (found in Cloudflare dashboard)
CFB_R2_ACCOUNT_ID=''

# R2 API credentials (create in Cloudflare dashboard: R2 > Manage R2 API Tokens)
CFB_R2_ACCESS_KEY=''
CFB_R2_SECRET_KEY=''

# R2 endpoint (auto-generated from account ID)
CFB_R2_ENDPOINT='https://<account-id>.r2.cloudflarestorage.com'

# Isolated preview bucket and credentials (required when ENV=preview)
CFB_R2_PREVIEW_BUCKET=''
CFB_R2_PREVIEW_ACCOUNT_ID=''
CFB_R2_PREVIEW_ACCESS_KEY=''
CFB_R2_PREVIEW_SECRET_KEY=''
CFB_R2_PREVIEW_ENDPOINT='https://<account-id>.r2.cloudflarestorage.com'

# Separately scoped object-read/list credentials for the historical source bucket.
# These are wrapped in a process-level read-only storage capability.
CFB_R2_SOURCE_BUCKET=''
CFB_R2_SOURCE_ACCOUNT_ID=''
CFB_R2_SOURCE_ACCESS_KEY=''
CFB_R2_SOURCE_SECRET_KEY=''
CFB_R2_SOURCE_ENDPOINT='https://<account-id>.r2.cloudflarestorage.com'

# Fail ingestion when an immutable capture cannot be registered in Neon.
CFB_REQUIRE_CATALOG='1'
# Keep request concurrency deliberately low for the CFBD service.
CFB_CFBD_MAX_CONCURRENCY='2'
CFB_CFBD_MAX_RETRIES='4'
# During migration, write immutable Bronze before any legacy projection.
CFB_LAKE_DUAL_WRITE='1'

# Optional signed Vercel on-demand revalidation (ISR remains fallback).
CFB_REVALIDATION_URL=''
REVALIDATION_SECRET=''

# Optional generic JSON webhook for failed publish-week, freeze-week, and close-week
# steps. Delivery is best-effort and cannot change the pipeline failure outcome.
CFB_OPS_ALERT_WEBHOOK_URL=''
CFB_OPS_ALERT_TIMEOUT_SECONDS=5

# ============================================================================
# AWS S3 Configuration (alternative to R2)
# ============================================================================
# S3 bucket name
CFB_S3_BUCKET=''

# S3 region (e.g., 'us-east-1')
CFB_S3_REGION='us-east-1'

# AWS credentials (from AWS IAM)
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''

# ============================================================================
# CFBD API Configuration
# ============================================================================
# College Football Data API key (get from https://collegefootballdata.com)
CFBD_API_KEY=''

# Paid The Odds API key used only for approved timestamped historical backfills.
THE_ODDS_API_KEY=''

# ============================================================================
# Email Publisher Configuration
# ============================================================================
PUBLISHER_SMTP_SERVER='smtp.gmail.com'
PUBLISHER_SMTP_PORT=587
PUBLISHER_EMAIL_SENDER=''
PUBLISHER_EMAIL_PASSWORD=''

# Email recipients
TEST_EMAIL_RECIPIENT=''
PROD_EMAIL_RECIPIENTS=[]

# ============================================================================
# Matplotlib Configuration
# ============================================================================
MPLCONFIGDIR='/Users/connorkitchings/.cache/matplotlib'
