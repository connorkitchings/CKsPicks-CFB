# Environment variables read by the code. Copy to .env and fill in; never commit values.
# Every entry is intentionally empty: defaults live in code. Do not set a variable
# you do not need. "Required" below means required for the stated workflow.
# web/.env.example lists the subset the Next.js app reads.

# ============================================================================
# Pipeline: runtime target and storage selection
# ============================================================================
# Storage backend: local, r2 or s3. Defaults to local. Required for any r2/s3 run.
CFB_STORAGE_BACKEND=
# Artifact environment: preview or production. Defaults to production. Set to preview for Preview runs.
CFB_ARTIFACT_ENV=
# Local data root. Required only when CFB_STORAGE_BACKEND=local.
CFB_MODEL_DATA_ROOT=
# Ephemeral working directory for build artifacts. Optional; code picks a temp root when unset.
CFB_WORK_ROOT=
# Neon Postgres URL for Production (pipeline role) and the web app. Required for catalog writes and publication.
DATABASE_URL=
# Neon Postgres URL for the isolated Preview branch. Required for Preview publication; must differ from DATABASE_URL.
PREVIEW_DATABASE_URL=
# Internal marker set by the ops CLI after it resolves the target. Do not set manually.
CFB_RUNTIME_TARGET_RESOLVED=
# Internal pipeline lease identity set by the ops CLI. Do not set manually.
CFB_PIPELINE_RUN_ID=
CFB_PIPELINE_LEASE_EPOCH=

# ============================================================================
# Pipeline: data sources, ingestion and retries
# ============================================================================
# College Football Data API key. Required for any CFBD fetch and for web logos:build.
CFBD_API_KEY=
# Paid The Odds API key. Required only with CFB_ODDS_API_ENABLED=1 or approved historical backfills.
THE_ODDS_API_KEY=
# Set to 1 to enable the weekly live The Odds API capture. Optional; off otherwise.
CFB_ODDS_API_ENABLED=
# Maximum concurrent CFBD requests. Optional; default 2.
CFB_CFBD_MAX_CONCURRENCY=
# Per-request CFBD timeout in seconds. Optional; default 60.
CFB_CFBD_REQUEST_TIMEOUT_SECONDS=
# Source fetch retry attempts. Optional; default 4.
CFB_SOURCE_MAX_ATTEMPTS=
# Base retry delay in seconds. Optional; default 0.5.
CFB_SOURCE_RETRY_BASE_SECONDS=
# Maximum retry delay in seconds. Optional; default 8.
CFB_SOURCE_RETRY_MAX_SECONDS=
# Timeout in seconds for a fetch-source subprocess. Optional; default 600.
CFB_SOURCE_SUBPROCESS_TIMEOUT_SECONDS=
# Set to 1 to fail ingestion when a capture cannot be registered in Neon. Optional; default 0.
CFB_REQUIRE_CATALOG=
# Set to 1 or 0 to force or disable the Bronze catalog dual-write. Optional; defaults to 1 on R2, 0 otherwise.
CFB_LAKE_DUAL_WRITE=
# Ingestion run identifier passed to child processes by the ops CLI. Optional; generated when unset.
CFB_INGESTION_RUN_ID=
# Optional generic JSON webhook for failed publish-week, freeze-week and close-week steps.
CFB_OPS_ALERT_WEBHOOK_URL=
# Webhook delivery timeout in seconds. Optional; default 5.
CFB_OPS_ALERT_TIMEOUT_SECONDS=

# ============================================================================
# Cloudflare R2 (used when CFB_STORAGE_BACKEND=r2)
# ============================================================================
# Production bucket credentials. Required for production R2 runs.
CFB_R2_BUCKET=
CFB_R2_ACCOUNT_ID=
CFB_R2_ACCESS_KEY=
CFB_R2_SECRET_KEY=
# R2 endpoint (https://ACCOUNT_ID.r2.cloudflarestorage.com). Required with the production credentials.
CFB_R2_ENDPOINT=
# Isolated Preview bucket credentials. Required when CFB_ARTIFACT_ENV=preview.
CFB_R2_PREVIEW_BUCKET=
CFB_R2_PREVIEW_ACCOUNT_ID=
CFB_R2_PREVIEW_ACCESS_KEY=
CFB_R2_PREVIEW_SECRET_KEY=
CFB_R2_PREVIEW_ENDPOINT=
# Read-only historical source bucket credentials. Required for source inventory and history import.
CFB_R2_SOURCE_BUCKET=
CFB_R2_SOURCE_ACCOUNT_ID=
CFB_R2_SOURCE_ACCESS_KEY=
CFB_R2_SOURCE_SECRET_KEY=
CFB_R2_SOURCE_ENDPOINT=
# Ratings-lab research bucket (no Preview/production fallback). Required only for scripts/research R2 runs.
CFB_R2_LAB_BUCKET=
CFB_R2_LAB_ACCOUNT_ID=
CFB_R2_LAB_ACCESS_KEY=
CFB_R2_LAB_SECRET_KEY=
CFB_R2_LAB_ENDPOINT=
# Ratings-lab read-only source bucket. Required together with the lab bucket.
CFB_R2_LAB_SOURCE_BUCKET=
CFB_R2_LAB_SOURCE_ACCOUNT_ID=
CFB_R2_LAB_SOURCE_ACCESS_KEY=
CFB_R2_LAB_SOURCE_SECRET_KEY=
CFB_R2_LAB_SOURCE_ENDPOINT=
# Local ratings-lab storage root, used instead of lab R2. Optional research alternative.
CFB_LAB_LOCAL_ROOT=

# ============================================================================
# AWS S3 (alternative backend, used when CFB_STORAGE_BACKEND=s3)
# ============================================================================
# S3 bucket name. Required for the s3 backend.
CFB_S3_BUCKET=
# S3 region. Required for the s3 backend.
CFB_S3_REGION=
# AWS credentials. Required for the s3 backend unless the default AWS credential chain applies.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# Web app (also listed in web/.env.example)
# ============================================================================
# Secret for signed on-demand revalidation (POST /api/revalidate). Required to enable that route.
REVALIDATION_SECRET=
# Season the web app publishes. Optional; defaults to the repo-owned season.
CFB_PUBLICATION_SEASON=
# Set to predictions to publish model output; anything else publishes market only. Optional.
CFB_PUBLICATION_MODE=
# Set to 1 to enable the Stats route and navigation item. Keep Production unset or 0.
CFB_CHARTS_ENABLED=
# Set to 0 to disable the Matchup pages (emergency switch). Optional; enabled by default.
CFB_MATCHUP_ENABLED=
# Set to 0 to disable the release-keyed data cache (kill switch). Optional; enabled by default.
CFB_DATA_CACHE=
# Set to 0 to hide the display-only notice. Optional; shown by default.
CFB_DISPLAY_ONLY_NOTICE=
# Set to 1 to log every database query with a per-request count. Optional; debugging only.
CFB_QUERY_LOG=

# ============================================================================
# Tests
# ============================================================================
# Postgres URL for DB integration tests. Disposable local cluster ONLY; never Preview or Production.
TEST_DATABASE_URL=
# Second disposable local database used as the promotion target in tests/test_promotion.py. Same restriction.
TEST_DATABASE_URL_TARGET=
# Set to 1 to run the web app on fixtures without a database (web dev and Playwright).
CFB_UI_TEST_MODE=
# Set to 1 to produce optional Stats visual review artifacts in the Playwright suite.
CFB_CHART_VISUALS=
# Playwright dev server port. Optional; default 3100.
PLAYWRIGHT_PORT=
# Path to a served serving-projections.json for the optional parity test in tests/test_projection_resume.py.
CKS_PARITY_SERVING_JSON=
