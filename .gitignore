.DS_Store

# Python
__pycache__/
*.py[codz]
*.egg-info/
*.egg
build/
dist/
.venv/
.uv_cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
cython_debug/
.pypirc

# Environments and secrets
.env*
!.env.example
!web/.env.example
.envrc
gha-creds-*.json

# Logs
*.log

# Node and build tooling (web/ has its own .gitignore)
node_modules/
.nx/
.vercel
.antigravitycli/

# Editor and agent tooling
.cursorignore
.cursorindexingignore
.geminiignore
.gemini/
.opencode/
.neon

# Local data directory (working copies only; durable data/artifacts live in R2)
/data/
/models/
catboost_info/
conf/local.yaml
list/

# Root-level archive folder (legacy); anchored so scripts/archive stays tracked
/archive/

# Binary artifacts (defense in depth; regenerable from training)
*.nc
*.joblib
*.pkl
*.pickle
*.h5
*.pt
*.safetensors

# Artifacts (keep directory structure, READMEs, and summaries; exclude large outputs)
artifacts/experiments/**/*.csv
artifacts/experiments/**/*.png
artifacts/experiments/**/*.jpg
artifacts/production/scored/
artifacts/production/monitoring/*.csv
artifacts/production/monitoring/*.json
artifacts/validation/**/*.csv
artifacts/cross_validation/**/crossval_fold_results.csv
artifacts/analysis/*
!artifacts/analysis/README.md
artifacts/archive/*
!artifacts/archive/MANIFEST.md
artifacts/preview/
artifacts/season/
artifacts/quality/
artifacts/rebuild/
artifacts/backups/2026-10-11/
artifacts/backups/week6-closeout-20261011/
artifacts/backups/*/investigation/*.parquet
artifacts/backups/*/investigation/*captures.json
artifacts/backups/*/investigation/cfbd_plays_*.json
artifacts/backups/*/investigation/*.py
artifacts/research/window2_5a_cfbd_drives/
artifacts/research/chart-explosiveness/

