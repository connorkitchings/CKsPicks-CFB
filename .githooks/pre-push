#!/usr/bin/env bash
# Pre-push gate for pushes of dev to origin. Enable with `make hooks`.
set -euo pipefail

remote_name="${1:-}"

cd "$(git rev-parse --show-toplevel)"

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$remote_name" == "origin" && "$remote_ref" == "refs/heads/dev" ]] || continue
  [[ "$local_sha" =~ ^0+$ ]] && continue

  if [[ "$remote_sha" =~ ^0+$ ]]; then
    range="origin/dev..${local_sha}"
  else
    range="${remote_sha}..${local_sha}"
  fi

  if command -v gh >/dev/null 2>&1; then
    running="$(gh run list --workflow weekly-season-update.yml --status in_progress --status queued \
      --json databaseId --jq 'length' 2>/dev/null </dev/null || true)"
    if [[ "$running" =~ ^[0-9]+$ && "$running" -gt 0 ]]; then
      echo "WARNING: weekly season update is running; pushing code to dev now can break that run" >&2
    fi
  fi

  echo "pre-push: gating push of dev (range ${range})" >&2
  make pre-push PRE_PUSH_RANGE="$range" </dev/null
done
exit 0
