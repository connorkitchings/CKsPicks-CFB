+def _deduplicate_source_plays(data: pd.DataFrame) -> pd.DataFrame:
+    """Collapse exact repeats, but never use play sequence as event identity.
+
+    A provider ID may legitimately share its displayed play number with another
+    event. Without IDs, differing rows at the same position are ambiguous and
+    need source review before they can enter a measurement build.
+    """
+    import json
+
+    df = data.copy()
+    position = ["season", "week", "game_id", "drive_number", "play_number"]
+    missing = sorted(set(position) - set(df.columns))
+    if missing:
+        raise ValueError(f"Source plays lack identity columns: {missing}")
+    id_column = "id" if "id" in df else "play_id" if "play_id" in df else None
+    if id_column:
+        ids = df[id_column].map(
+            lambda value: None if pd.isna(value) or str(value).strip() == "" else str(value)
+        )
+        df["source_play_id"] = ids
+    else:
+        df["source_play_id"] = None
+
+    # Only byte-equivalent source records may collapse. Provider IDs are
+    # checked separately so the same ID cannot denote two different plays.
+    signatures = df.drop(columns="source_play_id").apply(
+        lambda row: json.dumps(row.to_dict(), sort_keys=True, default=str), axis=1
+    )
+    duplicate = signatures.duplicated()
+    df = df.loc[~duplicate].copy()
+    with_ids = df[df["source_play_id"].notna()]
+    if with_ids.duplicated(["season", "game_id", "source_play_id"]).any():
+        raise ValueError("Conflicting records share a provider play ID")
+    for _, group in df.groupby(position, dropna=False, sort=False):
+        if len(group) > 1 and group["source_play_id"].isna().any():
+            raise ValueError("Distinct plays share a sequence without complete provider IDs")
+    return df
+
